# ATOM-NOT-B1 / GGP — .env
# Copy this file to the project root as ".env".
# Safe default: PAPER mode. No real exchange orders are sent.
# Never commit this file. Keep real API credentials private.

# =========================
# Trading mode — SAFE DEFAULT
# =========================
PAPER_MODE=false
ENABLE_LIVE_TRADING=true

# BingX Futures API credentials — fill locally only if/when you deliberately
# configure LIVE mode. Do not paste credentials into chat or commit this file.
BINGX_API_KEY=
BINGX_API_SECRET=

# =========================
# Market / strategy context
# =========================
SYMBOL=BTC/USDT
INTERVAL=15m

# The merged EMA9/EMA15 + UTC Session VWAP entry gate is implemented in code:
# closed-candle cross -> VWAP-side alignment -> Watchlist persistence ->
# Micro Retest or optional EMA50 Macro Pullback -> separate rejection candle ->
# later closed continuation confirmation -> final live-price revalidation.
#
# Institutional zones are location/TP1-room filters, not independent entry
# requirements. Cross age, ATR extension and location thresholds are code-owned.
# Do not add EMA/VWAP tuning variables here: the entry gate does not read them.
#
# Radar discovery window only (not the final entry authorization):
M15_TRIPLE_CROSS_WINDOW_CANDLES=4

# =========================
# Position sizing / risk policy
# =========================
# Repository policy is FIXED at 20x. The sizing engine rejects other leverage.
LEVERAGE=20
# Risk budget is a percentage of target trade margin, not total wallet balance.
MAX_TRADE_RISK_PCT=10.0
STOP_EXECUTION_BUFFER_PCT=0.05

# =========================
# Scanner / signal-only Sniper V2
# =========================
SNIPER_V2_ENABLED=true
SNIPER_V2_SCAN_INTERVAL=15
SNIPER_V2_MAX_SYMBOLS=8
SNIPER_V2_PIVOT_LOOKBACK=3
SNIPER_V2_ZONE_ATR_WIDTH=0.50
SNIPER_V2_SL_ATR_BUFFER=0.40
SNIPER_V2_ZONE_MAX_AGE_SEC=14400
SNIPER_V2_CONFIRMATION_WINDOW_BARS=3
SNIPER_V2_MAX_ENTRY_DISTANCE_ATR=0.75

# =========================
# Unified Profit Management Brain
# =========================
ENABLE_UNIFIED_PROFIT_BRAIN=true
PROFIT_BRAIN_SHADOW_MODE=false
# Keep false until separate LIVE authority validation is completed.
PROFIT_BRAIN_LIVE_AUTHORITY=false
PROFIT_BRAIN_MODE_HYSTERESIS_CANDLES=2

# =========================
# Recovery / persistence
# =========================
TRADE_JOURNAL_PATH=data/ggp_trade_journal.sqlite3
RECOVERY_RETRY_INTERVAL_SEC=20

# =========================
# Telegram — optional
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================
# Dashboard / hosting
# =========================
# Leave PORT empty locally; Render injects PORT automatically.
PORT=
DASHBOARD_LOCAL_PORTS=8000,8080
DASHBOARD_BIND_HOST=127.0.0.1

# Optional local override behavior. Leave unset unless you know why it is needed.
# GGP_LOCAL_ENV_OVERRIDE=false
